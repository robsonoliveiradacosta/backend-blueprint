#!/bin/sh
# Installs this directory's hooks into the repository, since git does not version
# .git/hooks. Idempotent, dependency-free, and a silent no-op outside a working
# clone (source tarball, Docker context, CI export without .git).
#
# The Maven build runs it in the validate phase. Any other stack calls it directly:
#
#   npm / pnpm   "scripts": { "prepare": "sh .githooks/install" }
#   gradle       exec { commandLine 'sh', '.githooks/install' }
#   anything     sh .githooks/install
#
# A repository driven by husky needs no copy at all: husky takes over
# core.hooksPath, so .git/hooks stops being consulted. Point its hook at the
# validator instead — .husky/commit-msg containing: sh .githooks/commit-msg "$1"

set -e

hooks_src=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# --git-common-dir, not --git-dir: hooks live in the main repository even when
# the build runs from a linked worktree.
git_common=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
case "$git_common" in
  /*) ;;
  *) git_common=$(CDPATH= cd -- "$git_common" && pwd) ;;
esac

hooks_dst="$git_common/hooks"
mkdir -p "$hooks_dst"

for src in "$hooks_src"/*; do
  [ -f "$src" ] || continue
  name=${src##*/}
  case "$name" in
    install|*.md) continue ;;
  esac

  dst="$hooks_dst/$name"
  if [ -f "$dst" ] && [ ! -L "$dst" ] && cmp -s "$src" "$dst"; then
    continue
  fi

  # Delete first: the destination may be a symlink into this directory, left by
  # an earlier manual install, and copying onto it writes through to the source.
  rm -f "$dst"
  cp "$src" "$dst"
  chmod 755 "$dst"
  echo "installed git hook: $name"
done
